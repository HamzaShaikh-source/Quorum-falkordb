# Quorum production configuration. Copy to .env.production (git-ignored) and fill EVERY value in.
# cp .env.production.example .env.production
#
# The values below are deliberately empty: compose refuses to start with an empty one, and the hub refuses to start with a
# copied-over placeholder, so there is no default credential to forget about.

# Strong random password for FalkorDB:  python -c "import secrets; print(secrets.token_urlsafe(24))"
FALKORDB_PASSWORD=

# Tokens the hub accepts. Generate them with:  python scripts/make_token.py --tenant acme --role human --name ops
# and paste the QUORUM_TOKENS_JSON=... line it prints here.
QUORUM_TOKENS_JSON=

# Where agents and people reach the hub (the TLS proxy), and the console's origin
QUORUM_PUBLIC_URL=https://localhost:8443
QUORUM_CORS_ORIGINS=https://localhost:8443

# A real certificate for a public name: set both (leave them out for a local, self-made certificate authority)
# QUORUM_DOMAIN=quorum.example.com
# QUORUM_TLS=you@example.com

# Which addresses may tell the hub the real client address (X-Forwarded-For). The compose files pin the proxy to
# 172.29.77.10; only change this if you run your own proxy, and never trust a whole private range on a published port.
# QUORUM_TRUSTED_PROXIES=127.0.0.1,::1,172.29.77.10

# Member tokens expire after this many days (0 = never)
QUORUM_MEMBER_TOKEN_TTL_DAYS=90
