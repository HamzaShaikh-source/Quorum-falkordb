{
  "name": "quorum-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "contrast": "node scripts/contrast.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "screens": "node scripts/screens.mjs",
    "qa": "node scripts/interact.mjs",
    "qa:live": "node scripts/live.mjs",
    "landing": "node scripts/landing-shots.mjs http://127.0.0.1:5173/ ../docs/screens/landing 1440",
    "verify": "npm run typecheck && npm run lint && npm test && npm run contrast && npm run contract:check && npm run build && npm run build:mock",
    "build:mock": "tsc --noEmit && vite build --mode mock --outDir dist-mock --emptyOutDir",
    "preview:mock": "vite preview --host 0.0.0.0 --outDir dist-mock --port 5173 --strictPort",
    "qa:cursor": "node scripts/cursor.mjs",
    "coverage": "vitest run --coverage",
    "qa:a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/schibsted-grotesk": "^5.1.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/react-query": "^5.59.0",
    "cytoscape": "^3.30.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.48.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
