# Quorum Environment Configuration

# Backend API
QUORUM_HOST=0.0.0.0
QUORUM_PORT=8000
QUORUM_API_PREFIX=/api
QUORUM_DEFAULT_TENANT=acme

# MCP Server (Streamable HTTP transport)
QUORUM_MCP_PORT=8001
QUORUM_MCP_HOST=0.0.0.0
QUORUM_MCP_URL=http://localhost:8001/mcp

# Database
QUORUM_FALKORDB_URL=redis://localhost:6379

# Execution Mode: "replay" (default, deterministic offline) or "live" (calls LLM)
QUORUM_MODE=replay

# Optional Live LLM configuration (auto-falls back to replay if keys are absent)
QUORUM_LLM_PROVIDER=gemini # "gemini", "openai", or "anthropic"
QUORUM_LLM_MODEL=gemini-2.5-flash

# API Keys (leave blank to run in zero-key replay mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
