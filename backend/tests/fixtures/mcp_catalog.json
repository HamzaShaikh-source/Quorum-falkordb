{
  "tools": [
    {
      "name": "remember_fact",
      "summary": "Store a fact with its source. scope=\"team\" keeps it private to your team (and linked teams)",
      "args": [
        {
          "name": "key",
          "required": true,
          "default": null
        },
        {
          "name": "value",
          "required": true,
          "default": null
        },
        {
          "name": "text",
          "required": true,
          "default": null
        },
        {
          "name": "token",
          "required": false,
          "default": ""
        },
        {
          "name": "id",
          "required": false,
          "default": null
        },
        {
          "name": "quote",
          "required": false,
          "default": null
        },
        {
          "name": "origin",
          "required": false,
          "default": null
        },
        {
          "name": "scope",
          "required": false,
          "default": "commons"
        }
      ],
      "who": "agent",
      "writes": true,
      "saves": "Store once, reference by id everywhere"
    },
    {
      "name": "derive",
      "summary": "Record a conclusion or decision from parent facts",
      "args": [
        {
          "name": "text",
          "required": true,
          "default": null
        },
        {
          "name": "parent_ids",
          "required": true,
          "default": null
        },
        {
          "name": "token",
          "required": false,
          "default": ""
        },
        {
          "name": "id",
          "required": false,
          "default": null
        },
        {
          "name": "is_decision",
          "required": false,
          "default": false
        },
        {
          "name": "owner_team",
          "required": false,
          "default": null
        }
      ],
      "who": "agent",
      "writes": true,
      "saves": "Conclusions are linked, not re-explained"
    },
    {
      "name": "retrieve_context",
      "summary": "Healthy, in-scope facts for a query, best match first. format=\"compact\" costs a fraction of the tokens",
