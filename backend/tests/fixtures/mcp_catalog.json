        {
          "name": "id",
          "required": true,
          "default": null
        },
        {
          "name": "token",
          "required": false,
          "default": ""
        }
      ],
      "who": "any",
      "writes": false,
      "saves": "A few lines instead of a document"
    },
    {
      "name": "find_path",
