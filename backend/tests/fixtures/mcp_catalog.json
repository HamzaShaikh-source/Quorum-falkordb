        {
          "name": "label",
          "required": true,
          "default": null
        },
        {
          "name": "action_type",
          "required": true,
          "default": null
        },
        {
          "name": "reversibility",
          "required": true,
          "default": null
        },
        {
          "name": "parent_ids",
          "required": true,
          "default": null
        },
        {
          "name": "token",
          "required": false,
          "default": ""
        },
        {
          "name": "id",
          "required": false,
          "default": null
